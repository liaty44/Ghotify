# 1. Apne Discord Bot ka Token yahan daalo
BOT_TOKEN=YOUR_DISCORD_BOT_TOKEN_HERE

# 2. Bot ka Prefix (Command chalane ke liye)
PREFIX=-!

# 3. Tera MongoDB Database URL (Local ya MongoDB Atlas ka)
MONGO_URI=mongodb://localhost:27017/ghotify

# 4. Render.com ke liye Port (Render isko automatically override kar leta hai)
PORT=8080
